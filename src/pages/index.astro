  :global(*){box-sizing:border-box} :global(html){scroll-behavior:smooth} :global(body){margin:0;background:#f2f2ee;color:#161616;font-family:Arial,Helvetica,sans-serif;overflow-x:hidden} :global(a){color:inherit} :global(::selection){background:#5a5a5a;color:#fff}
