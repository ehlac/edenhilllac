  .section{padding:110px 6vw}.section-label{font-size:.65rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase;border-top:1px solid #9e9a92;padding-top:13px}.about{display:grid;grid-template-columns:.7fr 1.2fr 1fr;gap:4vw}.about-heading{padding-top:30px}.section h2{font-size:clamp(3.6rem,7vw,7.5rem)}.kicker{color:#777}.about-copy{padding-top:110px}.about-copy .lead{font-family:Georgia,serif;font-size:1.6rem;line-height:1.35}.about-copy p:not(.lead){line-height:1.7;color:#68655f}.arrow-link{display:flex;justify-content:space-between;border-bottom:2px solid #111;padding:17px 0;text-decoration:none;text-transform:uppercase;font-weight:900;font-size:.75rem;margin-top:25px}.values{grid-column:2 / 4;display:grid;grid-template-columns:repeat(3,1fr);margin-top:55px;border-top:1px solid #b8b8b2}.values article{padding:25px 28px 0 0;border-right:1px solid #b8b8b2;min-height:180px}.values article+article{padding-left:28px}.values span{font-size:.65rem;color:#5a5a5a;font-weight:bold}.values strong{display:block;font-size:1.35rem;margin:35px 0 8px}.values p{color:#777;line-height:1.5;font-size:.9rem}
  .club-map{grid-column:1/-1;display:grid;grid-template-columns:minmax(260px,.65fr) 1.35fr;min-height:420px;margin-top:35px;background:#111;color:#f2f2ee;border:1px solid #111;overflow:hidden}.map-copy{padding:42px;display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-end}.map-copy h3{font:clamp(2.5rem,4vw,4.8rem)/.9 Impact,'Arial Black',sans-serif;text-transform:uppercase;letter-spacing:-.045em;margin:18px 0}.map-copy address{font-style:normal;color:#aaa;line-height:1.65;margin-bottom:28px}.map-copy .button{margin-top:auto}.club-map iframe{width:100%;height:100%;min-height:420px;border:0}
  .training{background:#141414;color:#f2f2ee;display:grid;grid-template-columns:.55fr 1fr 1.15fr;gap:4vw}.light{border-color:#494949}.coral{color:#5a5a5a}.training-title{padding-top:35px}.training-details{padding-top:55px}.training-details article{display:grid;grid-template-columns:45px 1fr;gap:10px;border-top:1px solid #444;padding:23px 0}.detail-no{font-size:.65rem;color:#5a5a5a;font-weight:bold}.training-details small,.join-card small,footer small{font-size:.58rem;color:#858585;letter-spacing:.15em;font-weight:bold}.training-details h3{margin:5px 0 7px;font-size:1.3rem}.training-details p{margin:0;color:#9c9c9c;line-height:1.5}.training-details a{display:inline-block;margin-top:12px;color:#5a5a5a;font-size:.7rem;text-transform:uppercase;font-weight:bold}.training-note{grid-column:2/4;border:1px solid #444;padding:24px 30px;display:grid;grid-template-columns:.5fr 2fr .7fr;align-items:center}.training-note strong{text-transform:uppercase;color:#5a5a5a;font-size:.75rem}.training-note p{color:#aaa}.training-note a{text-align:right;text-transform:uppercase;font-size:.7rem;font-weight:bold}
