---
import Layout from "../layouts/Layout.astro";

const facebook = "https://www.facebook.com/edenhilllac/";
const maps =
  "https://www.google.com/maps/search/?api=1&query=Jubilee+Reserve+Robinson+Road+Eden+Hill+WA";
type FaqItem = {
  question: string;
  answer: string;
  category: "registration" | "training" | "uniform" | "volunteering";
};
const faqs: FaqItem[] = [
  {
    question:
      "Can my child try Little Athletics before committing to full registration?",
    answer:
      'Yes! We offer a 2-Week "Come & Try" free trial for all new families. Your athlete can join our Monday or Wednesday training at Jubilee Reserve to experience the club environment before paying registration fees.',
    category: "registration",
  },
  {
    question: "How do I redeem my KidSport WA $300 Voucher?",
    answer:
      'KidSport vouchers are accepted! Apply for your voucher via the DLGSC WA website. Once approved, select "KidSport Voucher" when registering through the Athletics West portal and enter your unique voucher code.',
    category: "registration",
  },
  {
    question: "What is the Weather & Rain Policy for training sessions?",
    answer:
      "Training proceeds in light rain. If severe thunderstorms or extreme heat (>37°C) are forecast, official session modifications or cancellations are posted on our Facebook page ([facebook.com/edenhilllac/](http://facebook.com/edenhilllac/)) by 3:30 PM on training days.",
    category: "training",
  },
  {
    question: "Are running spikes permitted for young athletes?",
    answer:
      "Spikes are permitted ONLY for athletes in Under 11 (U11) age groups and older, restricted to track sprint events, hurdles, long jump, triple jump, high jump, and javelin.",
    category: "uniform",
  },
  {
    question:
      "Do parents need to stay during training sessions and Saturday meets?",
    answer:
      "Yes. Little Athletics is a family activity and not a drop-off service. A parent or designated guardian must remain at Jubilee Reserve and Noranda Complex to assist with supervision and safety.",
    category: "volunteering",
  },
];
const formatFaqAnswer = (answer: string) =>
  answer.replace(
    "[facebook.com/edenhilllac/](http://facebook.com/edenhilllac/)",
    `<a href="${facebook}" target="_blank" rel="noreferrer">facebook.com/edenhilllac/ ↗</a>`,
  );
const gallery = [
  {
    src: "hurdles.webp",
    alt: "Young Eden Hill athlete racing over hurdles",
    caption: "Flying high",
    size: "wide",
  },
  {
    src: "medals.webp",
    alt: "Eden Hill athlete proudly wearing competition medals",
    caption: "Earned with heart",
    size: "portrait",
  },
  {
    src: "group.webp",
    alt: "Eden Hill athletes smiling together at the oval",
    caption: "Better together",
    size: "portrait",
  },
  {
    src: "medals2.webp",
    alt: "A collection of athletics medals and ribbons",
    caption: "Moments to remember",
    size: "landscape",
  },
  {
    src: "pb1.webp",
    alt: "Young athlete celebrating a personal best",
    caption: "Chasing PBs",
    size: "portrait",
  },
  {
    src: "podium1.webp",
    alt: "Eden Hill athlete celebrating on the winners podium",
    caption: "Podium proud",
    size: "tall",
  },
  {
    src: "blue-tongue.webp",
    alt: "Club members enjoying a blue-tongue lizard visit",
    caption: "Oval visitors",
    size: "portrait",
  },
  {
    src: "champions.webp",
    alt: "Young Eden Hill champions with their awards",
    caption: "Our champions",
    size: "portrait",
  },
  {
    src: "pets.webp",
    alt: "Eden Hill club families with pets at a community day",
    caption: "The whole crew",
    size: "tall",
  },
  {
    src: "podium2.webp",
    alt: "Young athlete smiling with a podium award",
    caption: "Big smiles",
    size: "portrait",
  },
  {
    src: "pb2.webp",
    alt: "Eden Hill athlete celebrating a new personal best",
    caption: "Stronger every week",
    size: "portrait",
  },
  {
    src: "warmup.jpg",
    alt: "Eden Hill athletes warming up before a race",
    caption: "Give it a go",
    size: "portrait",
  },
];
const portraitPhotos = gallery.filter((photo) => photo.size !== "landscape");
const landscapePhotos = gallery.filter((photo) => photo.size === "landscape");
const carouselSlides = [];
for (let index = 0; index < portraitPhotos.length; index += 2) {
  carouselSlides.push({
    photos: portraitPhotos.slice(index, index + 2),
    layout: "portraits",
  });
}
landscapePhotos.forEach((photo) =>
  carouselSlides.push({ photos: [photo], layout: "landscape" }),
);
---

<Layout
  title="Eden Hill Little Athletics Club"
  description="A welcoming Little Athletics club for kids aged 5–17 in Eden Hill, Western Australia."
>
  <header class="site-header">
    <a
      class="brand"
      href="#top"
      aria-label="Eden Hill Little Athletics Club home"
    >
      <img src="/eden-hill-mark.jpg" alt="" />
      <span>Eden Hill <strong>Little Athletics</strong></span>
    </a>
    <nav aria-label="Main navigation">
      <a href="#about">Our club</a>
      <a href="#training">Training</a>
      <a href="#gallery">Gallery</a>
      <a href="#join">Join</a>
      <a href="#faq">FAQ</a>
    </nav>
    <a class="header-cta" href={facebook} target="_blank" rel="noreferrer"
      >Latest updates <span aria-hidden="true">↗</span></a
    >
  </header>

  <main id="top">
    <section class="hero">
      <div class="hero-track" aria-hidden="true">
        <i></i><i></i><i></i><i></i>
      </div>
      <div class="hero-copy">
        <p class="eyebrow"><span></span> Eden Hill, Western Australia</p>
        <h1>Run. Jump.<br /><em>Throw.</em> Grow.</h1>
        <p class="intro">
          Big energy, new friendships and personal bests. A local athletics club
          where kids aged 5–17 can move, learn and belong.
        </p>
        <div class="hero-actions">
          <a class="button button-light" href="#join"
            >Join the club <span>→</span></a
          >
          <a class="text-link" href="#training"
            ><span class="play">↓</span> See how training works</a
          >
        </div>
      </div>
      <div class="hero-art">
        <img
          src="/edenhilllac-poster.webp"
          alt="Eden Hill little athletes celebrating together on the oval"
          width="1800"
          height="1350"
          fetchpriority="high"
        />
        <div class="hero-sticker">
          AGES<br /><strong>5–17</strong><small>EVERYONE<br />WELCOME</small>
        </div>
      </div>
      <p class="scroll-note">Scroll to explore <span>↓</span></p>
    </section>

    <section class="ticker" aria-label="Club highlights">
      <div class="ticker-track" aria-hidden="true">
        <div class="ticker-group">
          <span
            >RUN <b>✦</b> JUMP <b>✦</b> THROW <b>✦</b> MAKE FRIENDS <b>✦</b> CHASE
            YOUR PB <b>✦</b> HAVE FUN <b>✦</b></span
          >
          <span
            >RUN <b>✦</b> JUMP <b>✦</b> THROW <b>✦</b> MAKE FRIENDS <b>✦</b> CHASE
            YOUR PB <b>✦</b> HAVE FUN <b>✦</b></span
          >
          <span
            >RUN <b>✦</b> JUMP <b>✦</b> THROW <b>✦</b> MAKE FRIENDS <b>✦</b> CHASE
            YOUR PB <b>✦</b> HAVE FUN <b>✦</b></span
          >
        </div>
        <div class="ticker-group">
          <span
            >RUN <b>✦</b> JUMP <b>✦</b> THROW <b>✦</b> MAKE FRIENDS <b>✦</b> CHASE
            YOUR PB <b>✦</b> HAVE FUN <b>✦</b></span
          >
          <span
            >RUN <b>✦</b> JUMP <b>✦</b> THROW <b>✦</b> MAKE FRIENDS <b>✦</b> CHASE
            YOUR PB <b>✦</b> HAVE FUN <b>✦</b></span
          >
          <span
            >RUN <b>✦</b> JUMP <b>✦</b> THROW <b>✦</b> MAKE FRIENDS <b>✦</b> CHASE
            YOUR PB <b>✦</b> HAVE FUN <b>✦</b></span
          >
        </div>
      </div>
    </section>

    <section class="about section" id="about">
      <div class="section-label">01 / Our club</div>
      <div class="about-heading">
        <p class="kicker">There’s a place for every pace.</p>
        <h2>Little club.<br />Big <em>spirit.</em></h2>
      </div>
      <div class="about-copy">
        <p class="lead">
          You don’t have to be the fastest. You just have to be ready to have a
          go.
        </p>
        <p>
          Eden Hill Little Athletics Club is a friendly, volunteer-led community
          for young athletes of all abilities. We help kids build skills and
          confidence across track and field—with plenty of encouragement along
          the way.
        </p>
        <a class="arrow-link" href={facebook} target="_blank" rel="noreferrer"
          >Meet us on Facebook <span>↗</span></a
        >
      </div>
      <div class="values">
        <article>
          <span>01</span><strong>Fun first</strong><p>
            Positive sessions that keep kids moving and smiling.
          </p>
        </article>
        <article>
          <span>02</span><strong>Personal bests</strong><p>
            Progress measured against yourself—not anyone else.
          </p>
        </article>
        <article>
          <span>03</span><strong>Community</strong><p>
            Families, coaches and volunteers all on the same team.
          </p>
        </article>
      </div>
    </section>

    <section class="training section" id="training">
      <div class="section-label light">02 / Training</div>
      <div class="training-title">
        <p class="eyebrow coral"><span></span> Weekly sessions</p><h2>
          Meet you<br />at the <em>oval.</em>
        </h2>
      </div>
      <div class="training-details">
        <article>
          <span class="detail-no">01</span><div>
            <small>WHEN</small><h3>Mondays + Wednesdays</h3><p>
              4:45pm – 6:00pm during the summer athletics season.
            </p>
          </div>
        </article>
        <article>
          <span class="detail-no">02</span><div>
            <small>WHERE</small><h3>Jubilee Reserve</h3><p>
              Stan Moses Pavilion, Robinson Road, Eden Hill.
            </p><a href={maps} target="_blank" rel="noreferrer"
              >Open in maps ↗</a
            >
          </div>
        </article>
        <article>
          <span class="detail-no">03</span><div>
            <small>WHAT TO BRING</small><h3>Water + a can-do attitude</h3><p>
              Wear comfortable sports clothes, runners and bring a water bottle.
            </p>
          </div>
        </article>
      </div>
      <div class="club-map">
        <div class="map-copy">
          <p class="eyebrow"><span></span> Our home ground</p>
          <h3>Jubilee Reserve</h3>
          <address>
            Stan Moses Pavilion<br />Robinson Road<br />Eden Hill WA 6054
          </address>
          <a
            class="button button-light"
            href={maps}
            target="_blank"
            rel="noreferrer">Get directions <span>↗</span></a
          >
        </div>
        <iframe
          title="Map showing Jubilee Reserve in Eden Hill"
          src="https://www.google.com/maps?q=Jubilee+Reserve%2C+Robinson+Road%2C+Eden+Hill+WA+6054&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <div class="training-note">
        <strong>Heads up!</strong><p>
          Training times and weather cancellations can change. Check Facebook
          before you head down.
        </p><a href={facebook} target="_blank" rel="noreferrer"
          >Check the latest →</a
        >
      </div>
    </section>

    <section class="join section" id="join">
      <div class="join-copy">
        <div class="section-label">03 / Join us</div>
        <p class="eyebrow coral"><span></span> Ready when you are</p>
        <h2>Your next PB<br />starts <em>here.</em></h2>
        <p>
          Registrations for each summer season are coordinated through Bayswater
          Little Athletics Centre. Kidsport vouchers are accepted—select Eden
          Hill Little Athletics Centre when applying.
        </p>
        <div class="join-actions">
          <a
            class="button button-coral"
            href="https://www.bayswaterlac.com.au/eden-hill-lac.html"
            target="_blank"
            rel="noreferrer">Registration details <span>↗</span></a
          ><a href={facebook} target="_blank" rel="noreferrer"
            >Ask us on Facebook →</a
          >
        </div>
      </div>
      <div class="join-card">
        <img
          src="/eden-hill-mark.jpg"
          alt="Eden Hill LAC hand-drawn bird emblem"
        />
        <small>QUICK DETAILS</small>
        <dl>
          <div><dt>Ages</dt><dd>5–17 years</dd></div><div>
            <dt>Club colours</dt><dd>Black + white</dd>
          </div><div><dt>2026/27 fee from</dt><dd>$240 / athlete</dd></div><div>
            <dt>Kidsport</dt><dd>Accepted</dd>
          </div>
        </dl>
        <p>
          Fees and season dates can change. Confirm current details before
          registering.
        </p>
      </div>
    </section>

    <section class="gallery-section section" id="gallery">
      <div class="section-label light">04 / Club life</div>
      <div class="gallery-heading">
        <p class="kicker">The moments between the finish lines.</p>
        <h2>Good days.<br />Great <em>memories.</em></h2>
        <p>
          Every medal, muddy shoe and massive smile tells a story. This is what
          Little Athletics looks like at Eden Hill.
        </p>
      </div>
      <div
        class="carousel"
        data-carousel
        aria-roledescription="carousel"
        aria-label="Eden Hill Little Athletics photo gallery"
      >
        <div class="carousel-viewport" data-carousel-viewport tabindex="0">
          {
            carouselSlides.map((slide, index) => (
              <div
                class={`carousel-slide ${slide.layout} ${slide.photos.length === 1 ? "solo" : ""}`}
                data-carousel-slide
                aria-roledescription="slide"
                aria-label={`${index + 1} of ${carouselSlides.length}: ${slide.photos.map((photo) => photo.caption).join(" and ")}`}
              >
                {slide.photos.map((photo) => (
                  <figure class="carousel-photo">
                    <img
                      class="carousel-backdrop"
                      src={`/images/gallery/${photo.src}`}
                      alt=""
                      aria-hidden="true"
                      loading="lazy"
                      decoding="async"
                    />
                    <img
                      class="carousel-image"
                      src={`/images/gallery/${photo.src}`}
                      alt={photo.alt}
                      loading={index === 0 ? "eager" : "lazy"}
                      decoding="async"
                    />
                    <figcaption>{photo.caption}</figcaption>
                  </figure>
                ))}
              </div>
            ))
          }
        </div>
        <button
          class="carousel-arrow previous"
          type="button"
          data-carousel-previous
          aria-label="Previous photo">←</button
        >
        <button
          class="carousel-arrow next"
          type="button"
          data-carousel-next
          aria-label="Next photo">→</button
        >
        <div class="carousel-controls">
          <p>
            <strong data-carousel-current>01</strong> / {
              String(carouselSlides.length).padStart(2, "0")
            }
          </p>
          <div class="carousel-dots" aria-label="Choose a photo">
            {
              carouselSlides.map((slide, index) => (
                <button
                  type="button"
                  data-carousel-dot={index}
                  aria-label={`Go to slide ${index + 1}: ${slide.photos.map((photo) => photo.caption).join(" and ")}`}
                  aria-current={index === 0 ? "true" : "false"}
                />
              ))
            }
          </div>
          <p class="swipe-hint">Swipe or use arrows</p>
        </div>
      </div>
      <div class="gallery-footer">
        <p>Want to see the latest action?</p><a
          href={facebook}
          target="_blank"
          rel="noreferrer">Follow the season on Facebook ↗</a
        >
      </div>
    </section>

    <section class="events section">
      <div class="section-label">05 / What we do</div>
      <div class="events-intro">
        <p class="kicker">Try it all. Find your favourite.</p><h2>
          Every event is<br />a new <em>adventure.</em>
        </h2>
      </div>
      <div class="event-grid">
        <article class="event-card orange">
          <span>01</span><figure class="event-photo">
            <img
              src="/images/events/run.webp"
              alt="Track athletes poised at the starting line"
              loading="lazy"
            /><figcaption>Photo · Braden Collum / Unsplash</figcaption>
          </figure><h3>Run</h3><p>
            Sprints, hurdles and distance events build speed, stamina and grit.
          </p>
        </article>
        <article class="event-card dark">
          <span>02</span><figure class="event-photo">
            <img
              src="/images/events/jump.webp"
              alt="Athlete soaring through a long jump"
              loading="lazy"
            /><figcaption>Photo · Peter Zhan / Unsplash</figcaption>
          </figure><h3>Jump</h3><p>
            Leap into long jump and high jump while learning great technique.
          </p>
        </article>
        <article class="event-card cream">
          <span>03</span><figure class="event-photo">
            <img
              src="/images/events/throw.webp"
              alt="Athlete launching a javelin on an athletics field"
              loading="lazy"
            /><figcaption>Photo · Andri Aeschlimann / Unsplash</figcaption>
          </figure><h3>Throw</h3><p>
            Discover shot put, discus and javelin in a safe, coached setting.
          </p>
        </article>
      </div>
    </section>

    <section class="faq-section section" id="faq">
      <div class="section-label light">06 / Need to know</div>
      <div class="faq-intro">
        <p class="kicker">Questions are always welcome.</p>
        <h2>Frequently<br /><em>asked.</em></h2>
        <p>
          Everything new families usually want to know before their first
          session.
        </p>
      </div>
      <div class="faq-list">
        {
          faqs.map((faq, index) => (
            <details class="faq-item" open={index === 0}>
              <summary>
                <span class="faq-number">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <strong>{faq.question}</strong>
                <span class="faq-category">{faq.category}</span>
                <span class="faq-toggle" aria-hidden="true" />
              </summary>
              <div class="faq-answer">
                <p set:html={formatFaqAnswer(faq.answer)} />
              </div>
            </details>
          ))
        }
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-brand">
      <img src="/eden-hill-mark.jpg" alt="" /><h2>Give it a go.</h2>
    </div>
    <div>
      <small>TRAIN WITH US</small><p>
        Mon + Wed · 4:45–6:00pm<br />Jubilee Reserve, Eden Hill
      </p>
    </div>
    <div class="footer-contact">
      <small>KEEP IN TOUCH</small><a
        href={facebook}
        target="_blank"
        rel="noreferrer">Facebook ↗</a
      ><a
        href="mailto:ehlac20@gmail.com?subject=Eden%20Hill%20Little%20Athletics%20enquiry"
        >ehlac20@gmail.com ↗</a
      ><p>
        Tap to email, or copy the address if your device has no mail app
        configured.
      </p>
    </div>
    <p class="copyright">
      © {new Date().getFullYear()} Eden Hill Little Athletics Club · Built for the
      next generation of little athletes.
    </p>
  </footer>
</Layout>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(html) {
    scroll-behavior: smooth;
  }
  :global(body) {
    margin: 0;
    background: #f2f2ee;
    color: #161616;
    font-family: Arial, Helvetica, sans-serif;
    overflow-x: hidden;
  }
  :global(a) {
    color: inherit;
  }
  :global(::selection) {
    background: #5a5a5a;
    color: #fff;
  }
  .site-header {
    height: 92px;
    padding: 0 4vw;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #f2f2ee;
    position: relative;
    z-index: 20;
    border-bottom: 1px solid #bcbcb7;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    text-transform: uppercase;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 0.9;
  }
  .brand img {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    mix-blend-mode: multiply;
  }
  .brand strong {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    margin-top: 5px;
  }
  .site-header nav {
    display: flex;
    gap: 34px;
  }
  .site-header nav a,
  .header-cta {
    text-transform: uppercase;
    text-decoration: none;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .site-header nav a:hover {
    text-decoration: underline;
    text-underline-offset: 7px;
  }
  .header-cta {
    background: #111;
    color: white;
    padding: 15px 18px;
  }
  .header-cta span {
    color: #5a5a5a;
    margin-left: 8px;
  }
  .hero {
    min-height: calc(100vh - 92px);
    background: #111;
    color: #f5f5f2;
    position: relative;
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    overflow: hidden;
  }
  .hero-track {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-track i {
    position: absolute;
    left: -20%;
    width: 75%;
    height: 150%;
    top: -22%;
    border-right: 1px solid #363636;
    border-radius: 0 100% 100% 0;
    transform: rotate(-5deg);
  }
  .hero-track i:nth-child(2) {
    left: -14%;
  }
  .hero-track i:nth-child(3) {
    left: -8%;
  }
  .hero-track i:nth-child(4) {
    left: -2%;
  }
  .hero-copy {
    padding: 9vw 4vw 9vw 7vw;
    z-index: 2;
    align-self: center;
  }
  .eyebrow,
  .kicker {
    font-size: 0.72rem;
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: 0.15em;
  }
  .eyebrow span {
    display: inline-block;
    width: 28px;
    height: 3px;
    background: #5a5a5a;
    vertical-align: middle;
    margin-right: 10px;
  }
  .hero h1,
  .section h2 {
    font-family: Impact, "Arial Black", sans-serif;
    text-transform: uppercase;
    letter-spacing: -0.055em;
    font-weight: 900;
    line-height: 0.84;
    margin: 0.35em 0;
  }
  .hero h1 {
    font-size: clamp(4.5rem, 9.7vw, 10rem);
  }
  .hero h1 em,
  .section h2 em {
    color: #5a5a5a;
    font-style: normal;
  }
  .intro {
    font-family: Georgia, serif;
    font-size: clamp(1.05rem, 1.4vw, 1.35rem);
    line-height: 1.55;
    max-width: 570px;
    color: #c9c7c1;
  }
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 34px;
    margin-top: 38px;
  }
  .button {
    display: inline-flex;
    justify-content: space-between;
    gap: 30px;
    padding: 18px 22px;
    text-decoration: none;
    text-transform: uppercase;
